# Nunca salve credenciais reais neste arquivo.
DATABASE_URL=postgresql://usuario:senha@host:5432/banco
PDV_WEB_URL=http://localhost:5173

# Login do PDV. Em produção (NODE_ENV=production) a API recusa as rotas
# operacionais enquanto PDV_AUTH_SECRET e os PINs não estiverem configurados.
PDV_AUTH_SECRET=
# PINs compartilhados (transição). Cadastre PINs individuais no Admin, em
# "Acesso dos vendedores", e depois defina PDV_REQUIRE_INDIVIDUAL_PIN=1.
PDV_OPERATOR_PIN=
PDV_MANAGER_PIN=
PDV_ADMIN_PIN=
PDV_ADMIN_NAME=Administrador
PDV_REQUIRE_INDIVIDUAL_PIN=
# Opcional fora de produção: exige login também no ambiente local.
PDV_REQUIRE_AUTH=

# Bling OAuth 2.0 / JWT
BLING_CLIENT_ID=
BLING_CLIENT_SECRET=
BLING_REDIRECT_URI=http://localhost:3333/integrations/bling/callback
# Restringe webhooks à empresa autorizada.
BLING_COMPANY_ID=
# Opcional: CNPJ da loja. Com ele, uma autorização feita por outra empresa no Bling é recusada.
BLING_COMPANY_CNPJ=
# Opcional: ID do contato "Consumidor Final" (sem CPF) usado nas vendas sem identificação.
# Fixar o ID impede que outro contato com nome parecido seja escolhido pela busca.
BLING_FINAL_CONSUMER_CONTACT_ID=

# Opcional: chave base64 de 32 bytes dedicada à criptografia dos tokens.
# Sem ela, a aplicação deriva uma chave do BLING_CLIENT_SECRET.
CREDENTIALS_ENCRYPTION_KEY=

# Compatibilidade temporária; prefira o fluxo OAuth acima.
BLING_ACCESS_TOKEN=

# Fidelizei (Fideliza+)
FIDELIZEI_API_URL=https://api.fidelizaplus.com.br/public/v1
FIDELIZEI_API_KEY=
